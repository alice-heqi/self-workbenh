# Supabase public connection settings.
# These two values are safe to use in the browser, but still do not grant write access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Do not add this to VITE_* variables,
# browser code, Git, or any file served by Vite.
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
